{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openwiz.outcome.v1",
  "title": "openwiz.outcome.v1",
  "description": "The decoded settings and claim of a v1 outcome. The reader also applies the file-level and semantic rules in outcome.v1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "claim",
    "proof",
    "allowed_paths",
    "cadence",
    "enabled"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+(?![\\s\\S])"
    },
    "claim": {
      "type": "string",
      "pattern": "^[^\\r\\n]+[.!?](?![\\s\\S])",
      "description": "The trimmed Markdown body as one plain sentence."
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "timeout"
      ],
      "properties": {
        "run": {
          "type": "string",
          "pattern": "^[^\\r\\n\\u0000]*[^\\s\\u0000][^\\r\\n\\u0000]*(?![\\s\\S])"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        }
      }
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?![A-Za-z]:)(?!\\.(?:\\.)?(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.(?:\\.)?(?:/|(?![\\s\\S])))[^/\\\\\\u0000-\\u001f\\u007f]+)*/?(?![\\s\\S])"
      }
    },
    "cadence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cron",
        "timezone"
      ],
      "properties": {
        "cron": {
          "type": "string",
          "pattern": "^[0-9*/,-]+(?: [0-9*/,-]+){4}(?![\\s\\S])"
        },
        "timezone": {
          "type": "string",
          "pattern": "^(?:UTC|[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)+)(?![\\s\\S])"
        }
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "secrets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*(?![\\s\\S])"
      },
      "default": []
    }
  }
}
